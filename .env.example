# -----------------------------------------------------------------
# Padho LPU - Environment Variables Template
# Copy this file to .env or .env.local and fill in your values.
# On Vercel: Add these variables under Project Settings -> Environment Variables.
# -----------------------------------------------------------------

# -- App ----------------------------------------------------------
NODE_ENV=production
# In Vercel, set APP_URL to your deployment URL, e.g. https://your-project.vercel.app or custom domain
APP_URL=https://padholpu.online

# -- Database (Neon PostgreSQL) -----------------------------------
# Neon pooled connection string:
# Example: postgresql://neondb_owner:your_password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require

# -- Cache & Distributed Coordination (Redis / Render Key Value) --
# Example: rediss://default:your-password@red-xyz.render.com:6379
# If omitted, application runs safely with in-memory / direct DB fallback.
REDIS_URL=rediss://default:password@host:6379

# -- Authentication (Required in Production) -----------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# -- Google OAuth (optional) --------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# -- Cloudinary (file uploads / avatars) --------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -- Cloudflare Turnstile (optional bot protection) ---------------
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# -- Email / SMTP (optional) --------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Padho LPU <noreply@padholpu.online>
